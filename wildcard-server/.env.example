# Variable names only. Real values go in /opt/wildcard-server/.env on CT 113 (step D). Never commit secrets.

# Colyseus port (default 2567)
PORT=2567

# MongoDB on CT 106, no auth. Unset = matches kept in memory only.
MONGO_URL=mongodb://10.0.0.230:27017
MONGO_DB=uno_hub

# Dashboard on CT 105. /api/game/me is used to check the homelab_session cookie.
DASHBOARD_BASE_URL=http://10.0.0.223:3000

# Where finished matches are POSTed (endpoint is built in step C) and the service token the dashboard expects.
# Both must be set, otherwise results are only logged/stored, not sent.
DASHBOARD_RESULTS_URL=
DASHBOARD_SERVICE_TOKEN=

# 1 = mount the Colyseus playground and monitor on / and /monitor (local debugging only)
ENABLE_DEBUG_UI=0
